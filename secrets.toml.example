# Copie este arquivo para .streamlit/secrets.toml apenas no seu computador.
# No Streamlit Cloud, cadastre os mesmos valores em App settings > Secrets.
SUPABASE_URL = "https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY = "sua-chave-anon-de-leitura"
SUPABASE_SERVICE_ROLE_KEY = "sua-chave-service-role-de-escrita"
SUPABASE_TABLE = "ibe_contagens"

# Acesso temporário à tela de lançamento. Altere antes de publicar.
ENTRY_USERNAME = "ibe"
ENTRY_PASSWORD = "ibe"
